# ============================================================
#  SERVILOCAL 2026 — Variables de entorno (API)
#  Copia este archivo como .env y ajusta los valores según
#  tu entorno local. Las credenciales de abajo corresponden
#  a la configuración Docker por defecto del proyecto.
# ============================================================

# --- Base de datos (PostgreSQL via Docker Compose) ----------
DATABASE_URL="postgresql://servilocal_user:servilocal_pass@localhost:5433/servilocal_db?schema=public"

# --- Cache (Redis via Docker Compose) -----------------------
REDIS_URL="redis://localhost:6379"

# --- Correo (Mailpit via Docker Compose) --------------------
MAIL_HOST="localhost"
MAIL_PORT="1025"
MAIL_FROM="no-reply@servilocal.local"

# --- URLs públicas ------------------------------------------
APP_WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# --- JWT / Autenticación ------------------------------------
AUTH_ACCESS_SECRET="servilocal_access_secret_dev_2026"
AUTH_ACCESS_TTL_SECONDS="900"
AUTH_REFRESH_TTL_DAYS="30"

# --- Tokens de restablecimiento de contraseña ---------------
PASSWORD_RESET_TTL_MINUTES="30"

# --- Contraseñas de Seed (datos iniciales) ------------------
ADMIN_SEED_PASSWORD="Admin12345*"
DEMO_USER_PASSWORD="Demo12345*"

# --- Contraseña para pruebas E2E ----------------------------
E2E_TEST_PASSWORD="Test1234!"

# --- CORS ---------------------------------------------------
CORS_ORIGINS="http://localhost:3000,http://192.168.18.24:3000"

# --- Cookie -------------------------------------------------
COOKIE_DOMAIN="localhost"
